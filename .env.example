# SpiderwebRouter non-secret deployment settings.
# Run scripts/init-env.sh or scripts/init-env.ps1; do not copy this file by hand.
COMPOSE_PROJECT_NAME=spiderwebrouter
PUBLIC_BASE_URL=__PUBLIC_BASE_URL__
TRUSTED_PROXY_CIDRS=__TRUSTED_PROXY_CIDRS__
INITIAL_ADMIN_EMAIL=__INITIAL_ADMIN_EMAIL__

SECRETS_DIR=./secrets
POSTGRES_USER=spiderwebrouter
POSTGRES_DB=spiderwebrouter
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_ADMIN_USERNAME=kcadmin

API_PORT=3000
LOG_LEVEL=info
UPSTREAM_REQUEST_TIMEOUT_MS=120000
# Browser console sessions expire after 7 days without activity and always
# expire 30 days after login. Values are seconds.
AUTH_SESSION_IDLE_SECONDS=604800
AUTH_SESSION_MAX_SECONDS=2592000
# Comma-separated Compose DNS names that may use plain HTTP as provider base URLs.
# Public, loopback, link-local, and metadata IP addresses remain blocked by the API.
ALLOWED_HTTP_PROVIDER_HOSTS=
