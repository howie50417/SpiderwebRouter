{
  "name": "spiderwebrouter",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted OpenAI-compatible multi-provider LLM gateway.",
  "license": "MIT",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @spiderwebrouter/api --filter @spiderwebrouter/web dev",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "prisma:generate": "pnpm --filter @spiderwebrouter/api prisma:generate",
    "prisma:migrate": "pnpm --filter @spiderwebrouter/api prisma:migrate"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
